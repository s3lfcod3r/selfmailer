+++ b/app/src/test/java/com/selfmailer/app/SyncBackoffTest.kt
@@ -0,0 +1,69 @@
+package com.selfmailer.app
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class SyncBackoffTest {
+    private val key = SyncKey(9, "INBOX")
+
+    @Test fun busyDoesNotCountAsSuccessAndWaitsFromCompletion() {
+        var now = 1000L
+        val policy = SyncBackoff { now }
+        val ticket = policy.begin(key)!!
+        now += 3000
+        policy.finish(ticket, SyncOutcome.BUSY)
+        now += 24999
+        assertNull(policy.begin(key))
+        now++
+        assertNotNull(policy.begin(key))
+    }
+
+    @Test fun busyBackoffGrowsAndIsBounded() {
+        var now = 1000L
+        val policy = SyncBackoff { now }
+        for (delay in listOf(25000L, 50000L, 100000L, 120000L, 120000L)) {
+            policy.finish(policy.begin(key)!!, SyncOutcome.BUSY)
+            now += delay - 1
+            assertNull(policy.begin(key))
+            now++
+        }
+        assertNotNull(policy.begin(key))
+    }
+
+    @Test fun manualRetryBypassesCooldownButNeverDuplicatesPendingWork() {
+        val policy = SyncBackoff { 1000L }
+        val first = policy.begin(key)!!
+        assertNull(policy.begin(key, manual = true))
+        policy.finish(first, SyncOutcome.BUSY)
+        assertNull(policy.begin(key))
+        val retry = policy.begin(key, manual = true)!!
+        policy.finish(retry, SyncOutcome.SUCCESS)
+        assertNotNull(policy.begin(key))
+    }
+
+    @Test fun stateIsSeparatedByAccountAndFolder() {
+        val policy = SyncBackoff { 1000L }
+        policy.finish(policy.begin(key)!!, SyncOutcome.ERROR)
+        assertNotNull(policy.begin(key.copy(account = 10)))
+        assertNotNull(policy.begin(key.copy(folder = "Sent")))
+        assertNull(policy.begin(key))
+    }
+
+    @Test fun cancellationReleasesPendingWithoutInventingSuccessOrFailure() {
+        val policy = SyncBackoff { 1000L }
+        policy.cancel(policy.begin(key)!!)
+        assertNotNull(policy.begin(key))
+    }
+
+    @Test fun logoutAndLateCompletionCannotTouchNewRequests() {
+        val policy = SyncBackoff { 1000L }
+        val old = policy.begin(key)!!
+        policy.clear()
+        val current = policy.begin(key)!!
+        policy.finish(old, SyncOutcome.BUSY)
+        policy.cancel(old)
+        assertNull(policy.begin(key))
+        policy.finish(current, SyncOutcome.SUCCESS)
+        assertNotNull(policy.begin(key))
+    }
+}
