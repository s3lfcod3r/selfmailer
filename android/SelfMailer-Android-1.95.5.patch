diff --git a/app/src/main/java/com/selfmailer/app/SyncBackoff.kt b/app/src/main/java/com/selfmailer/app/SyncBackoff.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/selfmailer/app/SyncBackoff.kt
@@ -0,0 +1,38 @@
+package com.selfmailer.app
+
+enum class SyncOutcome { SUCCESS, BUSY, ERROR }
+data class SyncKey(val account: Int, val folder: String)
+data class SyncTicket(val key: SyncKey, val serial: Long)
+
+/** UI-thread-owned; per-folder cooldown and in-flight guard, no stored mail data. */
+class SyncBackoff(private val now: () -> Long) {
+    private data class State(val failures: Int, val next: Long)
+    private val states = linkedMapOf<SyncKey, State>()
+    private val pending = mutableMapOf<SyncKey, Long>()
+    private var serial = 0L
+
+    fun begin(key: SyncKey, manual: Boolean = false): SyncTicket? {
+        if (pending.containsKey(key) || (!manual && now() < (states[key]?.next ?: 0L))) return null
+        val ticket = SyncTicket(key, ++serial)
+        pending[key] = ticket.serial
+        return ticket
+    }
+
+    fun finish(ticket: SyncTicket, outcome: SyncOutcome) {
+        if (pending[ticket.key] != ticket.serial) return
+        pending.remove(ticket.key)
+        if (outcome == SyncOutcome.SUCCESS) { states.remove(ticket.key); return }
+        val failures = ((states[ticket.key]?.failures ?: 0) + 1).coerceAtMost(8)
+        val maximum = if (outcome == SyncOutcome.BUSY) 120_000L else 300_000L
+        val delay = (25_000L * (1L shl (failures - 1))).coerceAtMost(maximum)
+        states.remove(ticket.key)
+        states[ticket.key] = State(failures, now() + delay)
+        while (states.size > 128) states.remove(states.keys.first())
+    }
+
+    fun cancel(ticket: SyncTicket) {
+        if (pending[ticket.key] == ticket.serial) pending.remove(ticket.key)
+    }
+
+    fun clear() { states.clear(); pending.clear() }
+}
