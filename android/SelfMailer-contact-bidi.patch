+package com.selfmailer.app
+
+import java.util.Locale
+
+val bidiFields = listOf("first_name", "last_name", "emails", "phones", "organization", "title", "website", "street", "postal_code", "city", "country", "notes", "birthday")
+val bidiLists = setOf("emails", "phones")
+fun bidiFieldLabel(key: String) = when(key) {
+    "first_name" -> "Vorname"; "last_name" -> "Nachname"; "emails" -> "E-Mail-Adressen"; "phones" -> "Telefonnummern"
+    "organization" -> "Firma"; "title" -> "Tätigkeit"; "website" -> "Website"; "street" -> "Straße"; "postal_code" -> "PLZ"
+    "city" -> "Ort"; "country" -> "Land"; "notes" -> "Notizen"; "birthday" -> "Geburtstag"; else -> key
+}
+data class SyncData(val fields: Map<String, List<String>>) {
+    init { require(fields.keys == bidiFields.toSet()); require(fields.all { (key, values) -> key in bidiLists || values.size == 1 }) }
+    fun text(key: String) = fields.getValue(key).single()
+    fun list(key: String) = fields.getValue(key)
+    val label get() = contactLabel(text("first_name"), text("last_name"), list("emails").firstOrNull().orEmpty())
+}
+fun syncCanonical(key: String, values: List<String>): List<String> {
+    val mapped = values.map { value -> when (key) {
+        "emails" -> value.trim().lowercase(Locale.ROOT)
+        "phones" -> phoneIdentity(value)
+        "notes" -> value.replace("\r\n", "\n")
+        else -> value.trim()
+    } }
+    return if (key in bidiLists) mapped.filter { it.isNotEmpty() }.distinct().sorted() else mapped
+}
+fun sameSync(a: SyncData, b: SyncData) = bidiFields.all { syncCanonical(it, a.list(it)) == syncCanonical(it, b.list(it)) }
+data class SyncMerge(val values: SyncData?, val conflicts: List<String>)
+fun mergeSync(base: SyncData, server: SyncData, phone: SyncData): SyncMerge {
+    val output = linkedMapOf<String, List<String>>(); val conflicts = mutableListOf<String>()
+    for (key in bidiFields) {
+        val old = syncCanonical(key, base.list(key)); val s = syncCanonical(key, server.list(key)); val p = syncCanonical(key, phone.list(key))
+        output[key] = when {
+            s == p -> server.list(key)
+            s == old -> phone.list(key)
+            p == old -> server.list(key)
+            else -> { conflicts += key; server.list(key) }
+        }
+    }
+    return SyncMerge(if (conflicts.isEmpty()) SyncData(output) else null, conflicts)
+}
+data class SyncServer(val id: Int, val created: String, val version: String, val values: SyncData, val readOnly: Boolean = false, val duplicate: Boolean = false)
+data class SyncPhone(val rawId: Long, val version: Long, val anchor: String, val values: SyncData, val readOnly: Boolean = false)
+data class SyncPair(val serverId: Int, val serverCreated: String, val rawId: Long, val anchor: String, val base: SyncData?, val blocked: Boolean = false, val reviewReason: String = "")
+enum class BidiStatus { OK, CONFLICT, PHONE_MISSING, SERVER_MISSING, READ_ONLY, DUPLICATE, STALE, FAILED }
+data class BidiOutcome(val pair: SyncPair, val status: BidiStatus, val fields: List<String> = emptyList(), val message: String = "", val changed: Boolean = false)
+interface BidiStore {
+    fun server(id: Int): SyncServer?
+    fun phone(rawId: Long): SyncPhone?
+    fun duplicatePhone(rawId: Long, desired: SyncData): Boolean
+    fun writeServer(expected: SyncServer, desired: SyncData)
+    fun writePhone(expected: SyncPhone, desired: SyncData)
+}
+class SyncStale(message: String) : IllegalStateException(message)
+class BidiProtocolRequired(message: String) : IllegalStateException(message)
+fun syncPair(pair: SyncPair, store: BidiStore, guard: () -> Unit = {}, force: String? = null, reviewVersions: Pair<String,Long>? = null): BidiOutcome {
+    require(force == null || force in setOf("server", "phone"))
+    require(force == null || reviewVersions != null) { "Konfliktauflösung benötigt einen geprüften Stand" }
+    guard()
+    try {
+        val server = store.server(pair.serverId) ?: return BidiOutcome(pair, BidiStatus.SERVER_MISSING)
+        if (server.created != pair.serverCreated) return BidiOutcome(pair.copy(blocked=true), BidiStatus.CONFLICT, message="Serveridentität geändert")
+        val phone = store.phone(pair.rawId) ?: return BidiOutcome(pair, BidiStatus.PHONE_MISSING)
+        if (phone.anchor != pair.anchor) return BidiOutcome(pair.copy(blocked=true), BidiStatus.CONFLICT, message="Handyverknüpfung fehlt oder Identität geändert")
+        if (reviewVersions != null && (server.version != reviewVersions.first || phone.version != reviewVersions.second)) return BidiOutcome(pair,BidiStatus.STALE,message="Werte seit Vorschau geändert")
+        if (server.readOnly || phone.readOnly) return BidiOutcome(pair, BidiStatus.READ_ONLY)
+        if (server.duplicate) return BidiOutcome(pair, BidiStatus.DUPLICATE)
+        val merge = when {
+            force == "server" -> SyncMerge(server.values, emptyList())
+            force == "phone" -> SyncMerge(phone.values, emptyList())
+            pair.blocked -> return BidiOutcome(pair, BidiStatus.CONFLICT, message=pair.reviewReason.ifBlank { "Änderung während Teilabgleich; Werte manuell prüfen" })
+            pair.base == null -> if (sameSync(server.values, phone.values)) SyncMerge(server.values, emptyList())
+                                 else SyncMerge(null, bidiFields.filter { syncCanonical(it, server.values.list(it)) != syncCanonical(it, phone.values.list(it)) })
+            else -> mergeSync(pair.base, server.values, phone.values)
+        }
+        val desired = merge.values ?: return BidiOutcome(pair, BidiStatus.CONFLICT, merge.conflicts)
+        if (store.duplicatePhone(pair.rawId, desired)) return BidiOutcome(pair, BidiStatus.DUPLICATE)
+        val changeServer = !sameSync(server.values, desired); val changePhone = !sameSync(phone.values, desired)
+        if (changeServer) { guard(); store.writeServer(server, desired) }
+        if (changePhone) { guard(); store.writePhone(phone, desired) }
+        guard()
+        val finalServer = store.server(pair.serverId); val finalPhone = store.phone(pair.rawId)
+        if (finalServer == null || finalPhone == null || finalServer.created != pair.serverCreated || finalPhone.anchor != pair.anchor ||
+            !sameSync(finalServer.values, desired) || !sameSync(finalPhone.values, desired)) {
+            return BidiOutcome(pair.copy(blocked=true), BidiStatus.CONFLICT, message="Während des Abgleichs geändert; bitte Werte prüfen")
+        }
+        if (finalServer.duplicate || finalServer.readOnly || finalPhone.readOnly) return BidiOutcome(pair.copy(blocked=true),BidiStatus.CONFLICT,message="Zuordnung oder Schreibfreigabe während des Abgleichs geändert")
+        return BidiOutcome(pair.copy(base=desired,blocked=false,reviewReason=""), BidiStatus.OK, changed=changeServer || changePhone)
+    } catch (e: kotlinx.coroutines.CancellationException) { throw e }
+    catch (e: SyncStale) { return BidiOutcome(pair, BidiStatus.STALE, message=e.message.orEmpty()) }
+    catch (e: Exception) { return BidiOutcome(pair, BidiStatus.FAILED, message=e.message.orEmpty()) }
+}
