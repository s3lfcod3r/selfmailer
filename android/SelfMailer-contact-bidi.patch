+package com.selfmailer.app
+
+import android.content.Context
+import org.json.JSONObject
+
+class BidiAdapter(private val ctx: Context, private val api: Api, private val prefs: Prefs, private val token: String,
+    private val owner: String, private val pair: SyncPair, private val automatic: Boolean) : BidiStore {
+    private val book=AndroidBidiBook(ctx,prefs,token,owner)
+    private val packets=mutableMapOf<Int,JSONObject>()
+    fun allowed(): Boolean {
+        val data=prefs.personalState();val selected=data.optJSONObject("bidi_pairs")?.optJSONObject(pair.serverId.toString())
+        return prefs.token==token && prefs.personalScope==owner && prefs.personalVerified && selected?.optString("anchor")==pair.anchor && (!automatic || data.optBoolean("contact_bidi"))
+    }
+    fun guard() { check(allowed()) { "Sitzung, Auswahl oder Freigabe geändert" } }
+    override fun server(id: Int): SyncServer? {
+        val packet=try { api.bidiContact(id) } catch(e: ApiException) {
+            if(e.status==404)return null
+            if(e.status==401)prefs.pausePersonalToken(token)
+            throw e
+        }
+        packets[id]=packet
+        return SyncServer(id,packet.getString("created_at"),packet.getString("updated_at"),serverSyncData(packet.getJSONObject("values")),packet.optBoolean("read_only"),packet.optBoolean("duplicate"))
+    }
+    override fun phone(rawId: Long) = book.snapshot(rawId)
+    override fun duplicatePhone(rawId: Long,desired: SyncData) = book.duplicate(rawId,desired)
+    override fun writeServer(expected: SyncServer,desired: SyncData) {
+        guard();val packet=packets.getValue(expected.id)
+        check(packet.getString("updated_at")==expected.version) { "Serverstand geändert" }
+        val body=JSONObject().put("expected_created_at",expected.created).put("expected_updated_at",expected.version)
+            .put("values",serverSyncPayload(packet.getJSONObject("values"),desired))
+        try { api.bidiWrite(expected.id,body) }
+        catch(e: ApiException) { if(e.status==409)throw SyncStale(e.message.orEmpty());if(e.status==401)prefs.pausePersonalToken(token);throw e }
+    }
+    override fun writePhone(expected: SyncPhone,desired: SyncData) { guard();book.write(expected,desired,::allowed) }
+}
+fun bidiStatus(status: String): String = when(status) {
+    "OK" -> "Abgeglichen";"CONFLICT" -> "Konflikt — Werte prüfen";"PHONE_MISSING" -> "Auf dem Handy entfernt/verknüpftes Konto fehlt"
+    "SERVER_MISSING" -> "Auf dem Server entfernt";"READ_ONLY" -> "Schreibgeschützt oder Angaben nicht abbildbar"
+    "DUPLICATE" -> "Duplikat/gleicher Name — manuell prüfen";"STALE" -> "Zwischenzeitlich geändert — beim nächsten Lauf neu prüfen"
+    "FAILED" -> "Abgleich angehalten";else -> "Noch nicht abgeglichen"
+}
