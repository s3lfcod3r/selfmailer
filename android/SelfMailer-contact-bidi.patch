+package com.selfmailer.app
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+fun SyncData.json() = JSONObject().also { out -> fields.forEach { (key, values) -> out.put(key, if (key in bidiLists) JSONArray(values) else values.single()) } }
+fun syncData(json: JSONObject) = SyncData(bidiFields.associateWith { key ->
+    if (key in bidiLists) MessageHeader.strList(json, key) else listOf(if (json.isNull(key)) "" else json.optString(key))
+})
+fun serverSyncData(json: JSONObject): SyncData {
+    val fields = bidiFields.associateWith { key -> when (key) {
+        "emails" -> (listOf(json.optString("email")) + MessageHeader.strList(json,"extra_emails")).filter { it.isNotBlank() }.distinctBy(::exportEmailIdentity)
+        "phones" -> (listOf(json.optString("phone"),json.optString("mobile"),json.optString("work_phone")) + MessageHeader.strList(json,"extra_phones")).filter { it.isNotBlank() }.distinctBy(::phoneIdentity)
+        else -> listOf(if (json.isNull(key)) "" else json.optString(key))
+    } }
+    return SyncData(fields)
+}
+fun serverSyncPayload(original: JSONObject, desired: SyncData): JSONObject {
+    val out = JSONObject(); bidiFields.filter { it !in bidiLists }.forEach { out.put(it,desired.text(it)) }
+    val emails=desired.list("emails").distinctBy(::exportEmailIdentity)
+    val primary=emails.firstOrNull { exportEmailIdentity(it)==exportEmailIdentity(original.optString("email")) } ?: emails.firstOrNull().orEmpty()
+    out.put("email",primary).put("extra_emails",JSONArray(emails.filter { exportEmailIdentity(it)!=exportEmailIdentity(primary) }))
+    val phones=desired.list("phones").distinctBy(::phoneIdentity).toMutableList()
+    for (key in listOf("mobile","work_phone","phone")) {
+        val old=original.optString(key); val value=phones.firstOrNull { old.isNotBlank() && phoneIdentity(it)==phoneIdentity(old) }.orEmpty()
+        out.put(key,value); if (value.isNotEmpty()) phones.remove(value)
+    }
+    if (out.optString("phone").isEmpty() && out.optString("mobile").isEmpty() && out.optString("work_phone").isEmpty() && phones.isNotEmpty()) out.put("phone",phones.removeAt(0))
+    out.put("extra_phones",JSONArray(phones))
+    return out
+}
+fun SyncPair.json(status: String = "", fields: List<String> = emptyList(), message: String = "") = JSONObject()
+    .put("server_id",serverId).put("server_created",serverCreated).put("raw_id",rawId).put("anchor",anchor)
+    .put("base",base?.json() ?: JSONObject.NULL).put("blocked",blocked).put("block_reason",reviewReason).put("status",status).put("fields",JSONArray(fields)).put("message",message)
+fun syncPair(json: JSONObject) = SyncPair(json.getInt("server_id"),json.getString("server_created"),json.getLong("raw_id"),json.getString("anchor"),
+    json.optJSONObject("base")?.let(::syncData),json.optBoolean("blocked"),json.optString("block_reason"))
+fun bidiPairs(prefs: Prefs): List<SyncPair> {
+    val pairs = prefs.personalState().optJSONObject("bidi_pairs") ?: return emptyList()
+    return pairs.keys().asSequence().map { syncPair(pairs.getJSONObject(it)) }.toList().also { require(it.size <= 200) }
+}
+fun saveBidi(prefs: Prefs, token: String, outcome: BidiOutcome): Boolean = prefs.updatePersonalState(token) { data ->
+    val pairs = data.optJSONObject("bidi_pairs") ?: JSONObject()
+    val current = pairs.optJSONObject(outcome.pair.serverId.toString())
+    if (current != null && current.optString("anchor")==outcome.pair.anchor) {
+        pairs.put(outcome.pair.serverId.toString(),outcome.pair.json(outcome.status.name,outcome.fields,outcome.message))
+        check(pairs.toString().toByteArray().size <= 2000000) { "Sync-Auswahl enthält zu viele Daten" }
+        data.put("bidi_pairs",pairs)
+    }
+}
