+package com.selfmailer.app
+
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Test
+import java.util.concurrent.TimeUnit
+
+class LogoutTest {
+    @Test fun logoutRevokesCapturedBearerSession() {
+        MockWebServer().use { server ->
+            server.enqueue(MockResponse().setResponseCode(200).setBody("{}"))
+            val api = Api(server.url("/").toString().trimEnd('/')).also { it.token = "synthetic-token" }
+            api.logout()
+            val request = server.takeRequest(2, TimeUnit.SECONDS)
+            assertNotNull(request)
+            assertEquals("POST", request!!.method)
+            assertEquals("/api/v1/auth/logout", request.path)
+            assertEquals("Bearer synthetic-token", request.getHeader("Authorization"))
+        }
+    }
+}
