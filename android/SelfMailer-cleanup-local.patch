+package com.selfmailer.app
+
+import java.net.URLEncoder
+
+/** Pure request contract shared by the live preview and JVM regression tests. */
+fun cleanupQuery(folder: String, field: String, value: String, before: String,
+                 onlyRead: Boolean, protect: Boolean, offset: Int): String {
+    require(field in listOf("from", "domain", "subject", "text", "label"))
+    require(value.isNotBlank() && offset >= 0)
+    fun encode(s: String) = URLEncoder.encode(s, "UTF-8")
+    val key = when (field) { "domain" -> "from"; "text" -> "q"; "label" -> "keyword"; else -> field }
+    val term = if (field == "domain") "@${value.removePrefix("@")}" else value
+    require(field != "domain" || term != "@")
+    return "folder=${encode(folder)}&limit=100&offset=$offset&$key=${encode(term)}" +
+        (if (before.isNotBlank()) "&before=${encode(before)}" else "") +
+        (if (onlyRead) "&seen=true" else "") + (if (protect) "&flagged=false" else "")
+}
