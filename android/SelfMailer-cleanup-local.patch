+package com.selfmailer.app
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.net.URLDecoder
+
+class CleanupQueryTest {
+    private fun params(field: String = "from", value: String = "shop@example.org", read: Boolean = false,
+                       protect: Boolean = true, offset: Int = 0) =
+        cleanupQuery("Invoices & projects", field, value, "2026-01-01", read, protect, offset).split('&').associate {
+            val (key, data) = it.split('=', limit = 2); key to URLDecoder.decode(data, "UTF-8")
+        }
+
+    @Test fun wholeFolderAndProtection() {
+        val p = params(read = true, offset = 200)
+        assertEquals("Invoices & projects", p["folder"]); assertEquals("100", p["limit"])
+        assertEquals("200", p["offset"]); assertEquals("true", p["seen"]); assertEquals("false", p["flagged"])
+        assertEquals("2026-01-01", p["before"])
+    }
+    @Test fun criteriaCannotInjectOtherParameters() {
+        val p = params(value = "shop+news@example.org&flagged=true")
+        assertEquals("shop+news@example.org&flagged=true", p["from"]); assertEquals("false", p["flagged"])
+    }
+    @Test fun textAndLabelsUseTheServerSearch() {
+        assertEquals("order 123", params("text", "order 123")["q"])
+        assertEquals("project", params("label", "project")["keyword"])
+    }
+    @Test fun domainHasOneAtSign() {
+        assertEquals("@example.org", params("domain", "@example.org")["from"])
+    }
+    @Test fun protectionsCanBeDisabled() {
+        val p = params(read = false, protect = false)
+        assertFalse(p.containsKey("seen")); assertFalse(p.containsKey("flagged"))
+    }
+    @Test(expected = IllegalArgumentException::class) fun emptySearchIsRejected() { params(value = " ") }
+    @Test(expected = IllegalArgumentException::class) fun unknownCriterionIsRejected() { params(field = "unknown") }
+    @Test(expected = IllegalArgumentException::class) fun negativeOffsetIsRejected() { params(offset = -1) }
+}
