+data class BookContact(val raw: JSONObject) {
+    val id get() = raw.getInt("id")
+    val first get() = raw.optString("first_name")
+    val last get() = raw.optString("last_name")
+    val email get() = raw.optString("email")
+    val phone get() = raw.optString("phone")
+    val mobile get() = raw.optString("mobile")
+    val work get() = raw.optString("work_phone")
+    val organization get() = raw.optString("organization")
+    val label get() = contactLabel(first, last, email)
+    val external get() = !raw.isNull("dav_account_id")
+    val extraEmails get() = MessageHeader.strList(raw, "extra_emails")
+    val extraPhones get() = MessageHeader.strList(raw, "extra_phones")
+    val allEmails get() = (listOf(email) + extraEmails).filter { it.isNotBlank() }.distinct()
+    val allPhones get() = (listOf(phone, mobile, work) + extraPhones).filter { it.isNotBlank() }.distinct()
+}
+
+fun readPhoneContacts(ctx: Context): List<PhoneEntry> {
+    check(ContextCompat.checkSelfPermission(ctx, Manifest.permission.READ_CONTACTS) == PackageManager.PERMISSION_GRANTED) { "Kontaktzugriff nicht erlaubt" }
+    val kinds = listOf(ContactsContract.CommonDataKinds.StructuredName.CONTENT_ITEM_TYPE, ContactsContract.CommonDataKinds.Email.CONTENT_ITEM_TYPE,
+        ContactsContract.CommonDataKinds.Phone.CONTENT_ITEM_TYPE, ContactsContract.CommonDataKinds.Organization.CONTENT_ITEM_TYPE)
+    val rows = linkedMapOf<String, MutableList<List<String>>>()
+    ctx.contentResolver.query(Data.CONTENT_URI, arrayOf(Data.LOOKUP_KEY, Data.MIMETYPE, Data.DATA1, Data.DATA2, Data.DATA3, Data.DISPLAY_NAME),
+        "${Data.MIMETYPE} IN (${kinds.joinToString(",") { "?" }})", kinds.toTypedArray(), "${Data.CONTACT_ID} ASC, ${Data._ID} ASC")?.use { cursor ->
+        while (cursor.moveToNext()) {
+            val key = cursor.getString(0) ?: continue
+            val data = (1..5).map { cursor.getString(it) ?: "" }
+            val values = rows.getOrPut(key) { mutableListOf() }
+            check(rows.size <= 10000 && values.size < 100) { "Handy-Adressbuch zu groß; keine Kontakte wurden hochgeladen" }
+            values.add(data)
+        }
+    } ?: error("Handykontakte konnten nicht vollständig gelesen werden")
+    check(rows.size <= 10000) { "Mehr als 10000 Handykontakte — Import bitte über ein kleineres Adressbuch durchführen" }
+    return rows.map { (key, values) ->
+        val name = values.firstOrNull { it[0] == kinds[0] }
+        val emails = values.filter { it[0] == kinds[1] }.map { it[1].trim() }.filter { it.isNotEmpty() }.distinctBy { it.lowercase() }.sorted()
+        val phones = values.filter { it[0] == kinds[2] }.map { it[1].trim() to (it[2].toIntOrNull() ?: 0) }.filter { it.first.isNotEmpty() }.distinctBy { phoneIdentity(it.first) }.sortedBy { phoneIdentity(it.first) }
+        check(emails.size <= 21 && phones.size <= 23) { "Kontakt hat zu viele Adressen/Nummern; keine Daten wurden hochgeladen" }
+        PhoneEntry(key, name?.get(2).orEmpty().ifBlank { if (name?.get(3).isNullOrBlank()) values.first()[4] else "" },
+            name?.get(3).orEmpty(), emails, phones, values.firstOrNull { it[0] == kinds[3] }?.get(1).orEmpty())
+    }.sortedBy { contactLabel(it.first, it.last, it.emails.firstOrNull().orEmpty()).lowercase() }
+}
+
+fun PhoneEntry.payload(): JSONObject {
+    val mobile = phones.firstOrNull { it.second == ContactsContract.CommonDataKinds.Phone.TYPE_MOBILE }?.first.orEmpty()
+    val work = phones.firstOrNull { it.second == ContactsContract.CommonDataKinds.Phone.TYPE_WORK }?.first.orEmpty()
+    val phone = phones.firstOrNull { it.first != mobile && it.first != work }?.first.orEmpty()
+    return JSONObject().put("source_key", key).put("first_name", first).put("last_name", last)
+        .put("email", emails.firstOrNull().orEmpty()).put("extra_emails", JSONArray(emails.drop(1)))
+        .put("phone", phone).put("mobile", mobile).put("work_phone", work)
+        .put("extra_phones", JSONArray(phones.map { it.first }.filter { it != mobile && it != work && it != phone }))
+        .put("organization", organization)
+}
+
+fun contactDeviceId(prefs: Prefs, token: String): String {
+    check(prefs.personalVerified) { "Für den Handyabgleich bitte den SelfMailer-Server aktualisieren und neu anmelden" }
+    prefs.updatePersonalState(token) { if (!it.has("device_id")) it.put("device_id", java.util.UUID.randomUUID().toString()) }
+    return prefs.personalState().getString("device_id")
+}
+
+fun PhoneEntry.fingerprint(): String = java.security.MessageDigest.getInstance("SHA-256")
+    .digest(payload().toString().toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) }
