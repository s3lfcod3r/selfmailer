+package com.selfmailer.app
+
+import android.Manifest
+import android.app.AlarmManager
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.content.ContextCompat
+import org.json.JSONObject
+
+object CalendarReminders {
+    private fun pending(ctx: Context, scope: String, id: String, snooze: Boolean = false): PendingIntent {
+        val intent = Intent(ctx, CalendarReminderReceiver::class.java).setAction("selfmailer.reminder.$scope.$id" + if (snooze) ".snooze" else "")
+            .putExtra("scope", scope).putExtra("event", id).putExtra("snooze", snooze)
+        return PendingIntent.getBroadcast(ctx, 0, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    }
+    private fun arm(ctx: Context, scope: String, id: String, row: JSONObject) {
+        val manager = ctx.getSystemService(AlarmManager::class.java)
+        val time = row.optLong("fire_at")
+        val now = System.currentTimeMillis()
+        val end = runCatching { java.time.Instant.parse(row.getString("end")).toEpochMilli() }.getOrDefault(0)
+        if (!row.optBoolean("delivered") && (end > now || row.optBoolean("snoozed"))) {
+            val fire = maxOf(time, now + 2000)
+            try {
+                if (Build.VERSION.SDK_INT < 31 || manager.canScheduleExactAlarms()) manager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, fire, pending(ctx, scope, id))
+                else manager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, fire, pending(ctx, scope, id))
+            } catch (_: SecurityException) { manager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, fire, pending(ctx, scope, id)) }
+        }
+    }
+    fun set(ctx: Context, event: Event, minutes: Int?, expectedToken: String? = null) {
+        val prefs = Prefs(ctx); val token = prefs.token ?: return
+        check(prefs.personalVerified) { "Für Erinnerungen bitte den SelfMailer-Server aktualisieren und neu anmelden" }
+        if (expectedToken != null && token != expectedToken) return
+        require(minutes == null || event.createdAt.isNotBlank()) { "Für Erinnerungen bitte auch den SelfMailer-Server aktualisieren" }
+        require(minutes == null || prefs.personalState().optJSONObject("reminders")?.has(event.id.toString()) == true || (prefs.personalState().optJSONObject("reminders")?.length() ?: 0) < 200) { "Höchstens 200 aktive Terminerinnerungen" }
+        ctx.getSystemService(AlarmManager::class.java).cancel(pending(ctx, prefs.personalScope, event.id.toString()))
+        NotificationManagerCompat.from(ctx).cancel("calendar:${prefs.personalScope}:${event.id}", 0)
+        check(prefs.updatePersonalState(token) { state ->
+            val rows = state.optJSONObject("reminders") ?: JSONObject()
+            if (minutes == null) rows.remove(event.id.toString()) else rows.put(event.id.toString(), JSONObject()
+                .put("start", event.start).put("end", event.end).put("all_day", event.allDay).put("minutes", minutes)
+                .put("created", event.createdAt)
+                .put("fire_at", reminderMillis(event, minutes)).put("title", event.title.take(200)).put("delivered", false))
+            state.put("reminders", rows)
+        }) { "Erinnerung konnte nicht gespeichert werden" }
+        restore(ctx); PersonalSync.configure(ctx)
+    }
+    fun restore(ctx: Context) {
+        val prefs = Prefs(ctx); if (!prefs.personalVerified) return
+        val token = prefs.token ?: return
+        val rows = prefs.personalState().optJSONObject("reminders") ?: return
+        rows.keys().forEach { id ->
+            val row = rows.getJSONObject(id)
+            if (row.optBoolean("all_day") && !row.optBoolean("delivered") && !row.optBoolean("snoozed")) {
+                val time = java.time.LocalDate.parse(row.getString("start").take(10)).atTime(9, 0).atZone(java.time.ZoneId.systemDefault()).toInstant().toEpochMilli() - row.optInt("minutes") * 60000L
+                prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.optJSONObject(id)?.put("fire_at", time) }
+                row.put("fire_at", time)
+            }
+            prefs.withPersonalToken(token, prefs.personalScope) { arm(ctx, prefs.personalScope, id, row) }
+        }
+    }
+    fun cancelAll(ctx: Context) {
+        val prefs = Prefs(ctx); val rows = prefs.personalState().optJSONObject("reminders") ?: return
+        rows.keys().forEach { id ->
+            ctx.getSystemService(AlarmManager::class.java).cancel(pending(ctx, prefs.personalScope, id))
+            NotificationManagerCompat.from(ctx).cancel("calendar:${prefs.personalScope}:$id", 0)
+        }
+    }
+    fun reconcile(ctx: Context, events: List<Event>, token: String) {
+        val prefs = Prefs(ctx); if (prefs.token != token) return
+        val byId = events.associateBy { it.id.toString() }
+        val rows = prefs.personalState().optJSONObject("reminders") ?: return
+        for (id in rows.keys().asSequence().toList()) {
+            val current = rows.getJSONObject(id); val ev = byId[id]
+            val action = reminderUpdate(current.optString("created"), current.optString("start"), current.optBoolean("all_day"), ev)
+            if (action == ReminderUpdate.REMOVE) {
+                ctx.getSystemService(AlarmManager::class.java).cancel(pending(ctx, prefs.personalScope, id))
+                prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.remove(id) }
+                NotificationManagerCompat.from(ctx).cancel("calendar:${prefs.personalScope}:$id", 0)
+            } else if (action == ReminderUpdate.RESCHEDULE) {
+                set(ctx, ev!!, current.getInt("minutes"), token)
+            } else {
+                prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.optJSONObject(id)?.put("title", ev!!.title.take(200))?.put("end", ev.end) }
+            }
+        }
+        restore(ctx)
+    }
+    fun fire(ctx: Context, intent: Intent) {
+        val prefs = Prefs(ctx); val token = prefs.token ?: return
+        val scope = intent.getStringExtra("scope") ?: return
+        val id = intent.getStringExtra("event") ?: return
+        if (scope != prefs.personalScope || !prefs.personalVerified) return
+        val row = prefs.personalState().optJSONObject("reminders")?.optJSONObject(id) ?: return
+        val tag = "calendar:$scope:$id"
+        if (intent.getBooleanExtra("snooze", false)) {
+            if (!row.optBoolean("delivered")) return
+            if (!prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.optJSONObject(id)
+                ?.put("fire_at", System.currentTimeMillis() + 600000)?.put("delivered", false)?.put("snoozed", true) }) return
+            NotificationManagerCompat.from(ctx).cancel(tag, 0); restore(ctx); return
+        }
+        if (row.optBoolean("delivered") || row.optLong("fire_at") > System.currentTimeMillis()) return
+        if (Build.VERSION.SDK_INT >= 33 && ContextCompat.checkSelfPermission(ctx, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return
+        if (!NotificationManagerCompat.from(ctx).areNotificationsEnabled()) return
+        if (!prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.optJSONObject(id)?.put("delivered", true) }) return
+        val channel = "selfmailer-calendar"
+        ctx.getSystemService(NotificationManager::class.java).createNotificationChannel(NotificationChannel(channel, "Kalender-Erinnerungen", NotificationManager.IMPORTANCE_DEFAULT))
+        val open = PendingIntent.getActivity(ctx, 0, Intent(ctx, MainActivity::class.java).setAction("selfmailer.calendar.$scope.$id")
+            .putExtra("personal_calendar", true), PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        prefs.withPersonalToken(token, scope) { try { NotificationManagerCompat.from(ctx).notify(tag, 0, NotificationCompat.Builder(ctx, channel).setSmallIcon(android.R.drawable.ic_dialog_info)
+            .setContentTitle(row.optString("title").ifBlank { "Kalendertermin" }).setContentText(row.optString("start"))
+            .setContentIntent(open).setAutoCancel(true).setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+            .addAction(0, "10 Min. später", pending(ctx, scope, id, true)).build())
+        } catch (_: SecurityException) { prefs.updatePersonalState(token) { it.optJSONObject("reminders")?.optJSONObject(id)?.put("delivered", false) } } }
+    }
+}
+
+class CalendarReminderReceiver : BroadcastReceiver() {
+    override fun onReceive(ctx: Context, intent: Intent) { CalendarReminders.fire(ctx, intent) }
+}
