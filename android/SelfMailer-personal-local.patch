+package com.selfmailer.app
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.time.LocalDate
+import java.time.ZoneId
+
+class PersonalDataTest {
+    private fun ev(start: String, end: String, allDay: Boolean = false) = Event(1, "Test", "", "", start, end, allDay, null, "local", "", "")
+    @Test fun labelsFallBackWithoutInventingNames() {
+        assertEquals("Anna Example", contactLabel(" Anna ", "Example ", "a@b"))
+        assertEquals("a@b", contactLabel("", "", "a@b"))
+        assertEquals("(ohne Namen)", contactLabel("", "", ""))
+    }
+    @Test fun phoneFormattingIsNormalizedConservatively() {
+        assertEquals("+49123456789", phoneIdentity("0049 (123) 456789"))
+        assertEquals("0123456789", phoneIdentity("0123 456789"))
+        assertNotEquals(phoneIdentity("0123456789"), phoneIdentity("+49123456789"))
+    }
+    @Test fun conflictsAndDeletedContactsCannotBeAutomaticallyApplied() {
+        listOf("conflict", "ambiguous", "server_deleted", "not_linked", "external", "duplicate_input", "possible_duplicate").forEach {
+            assertFalse(it, it in safePhoneStatuses)
+        }
+    }
+    @Test fun ongoingEventsAppearToday() {
+        val event = ev("2026-10-12T21:00:00Z", "2026-10-14T10:00:00Z")
+        assertEquals(LocalDate.parse("2026-10-13"), agendaDay(event, LocalDate.parse("2026-10-13"), 7, ZoneId.of("UTC")))
+    }
+    @Test fun pastEventsAndEighthDayAreExcluded() {
+        val today = LocalDate.parse("2026-10-13")
+        assertNull(agendaDay(ev("2026-10-12T10:00:00Z", "2026-10-12T11:00:00Z"), today, 7, ZoneId.of("UTC")))
+        assertNull(agendaDay(ev("2026-10-20T10:00:00Z", "2026-10-20T11:00:00Z"), today, 7, ZoneId.of("UTC")))
+    }
+    @Test fun todayUsesDeviceTimezone() {
+        val event = ev("2026-10-12T23:30:00Z", "2026-10-13T00:30:00Z")
+        assertEquals(LocalDate.parse("2026-10-13"), agendaDay(event, LocalDate.parse("2026-10-13"), 1, ZoneId.of("Europe/Berlin")))
+    }
+    @Test fun allDayEndIsExclusiveEvenWestOfUtc() {
+        val event = ev("2026-10-13T00:00:00Z", "2026-10-14T00:00:00Z", true)
+        assertEquals(LocalDate.parse("2026-10-13"), agendaDay(event, LocalDate.parse("2026-10-13"), 1, ZoneId.of("America/Los_Angeles")))
+        assertNull(agendaDay(event, LocalDate.parse("2026-10-14"), 1, ZoneId.of("America/Los_Angeles")))
+    }
+    @Test fun timedReminderHasCorrectOffset() {
+        val event = ev("2026-10-13T10:00:00Z", "2026-10-13T11:00:00Z")
+        assertEquals(java.time.Instant.parse("2026-10-13T09:45:00Z").toEpochMilli(), reminderMillis(event, 15, ZoneId.of("UTC")))
+    }
+    @Test fun allDayReminderIsNineLocalTimeAcrossDst() {
+        val event = ev("2026-10-25T00:00:00Z", "2026-10-26T00:00:00Z", true)
+        assertEquals(java.time.Instant.parse("2026-10-25T08:00:00Z").toEpochMilli(), reminderMillis(event, 0, ZoneId.of("Europe/Berlin")))
+    }
+    @Test fun invalidDatesDoNotCrashAgenda() {
+        assertNull(agendaDay(ev("bad", "bad"), LocalDate.now(), 7))
+    }
+    @Test(expected = IllegalArgumentException::class) fun invalidReminderOffsetIsRejected() {
+        reminderMillis(ev("2026-10-13T10:00:00Z", "2026-10-13T11:00:00Z"), -15)
+    }
+    @Test fun deletedOrReplacedEventRemovesReminderInsteadOfUsingReusedId() {
+        val event = ev("2026-10-13T10:00:00Z", "2026-10-13T11:00:00Z").copy(createdAt = "new")
+        assertEquals(ReminderUpdate.REMOVE, reminderUpdate("old", event.start, false, event))
+        assertEquals(ReminderUpdate.REMOVE, reminderUpdate("old", event.start, false, null))
+    }
+    @Test fun changedStartOrAllDayReschedules() {
+        val event = ev("2026-10-13T10:00:00Z", "2026-10-13T11:00:00Z").copy(createdAt = "same")
+        assertEquals(ReminderUpdate.RESCHEDULE, reminderUpdate("same", "2026-10-13T09:00:00Z", false, event))
+        assertEquals(ReminderUpdate.RESCHEDULE, reminderUpdate("same", event.start, true, event))
+    }
+    @Test fun changingOnlyTitleOrEndDoesNotDeliverTwice() {
+        val event = ev("2026-10-13T10:00:00Z", "2026-10-13T12:00:00Z").copy(createdAt = "same", title = "Renamed")
+        assertEquals(ReminderUpdate.METADATA_ONLY, reminderUpdate("same", event.start, false, event))
+    }
+}
