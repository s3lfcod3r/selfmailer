+package com.selfmailer.app
+
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+fun eventStartMillis(event: Event, zone: ZoneId = ZoneId.systemDefault()): Long =
+    if (event.allDay) LocalDate.parse(event.start.take(10)).atTime(9, 0).atZone(zone).toInstant().toEpochMilli()
+    else Instant.parse(event.start).toEpochMilli()
+
+fun agendaDay(event: Event, today: LocalDate, days: Long, zone: ZoneId = ZoneId.systemDefault()): LocalDate? = try {
+    val start = if (event.allDay) LocalDate.parse(event.start.take(10)) else Instant.parse(event.start).atZone(zone).toLocalDate()
+    val end = if (event.allDay) LocalDate.parse(event.end.take(10)).minusDays(1).coerceAtLeast(start)
+        else Instant.parse(event.end).minusMillis(1).atZone(zone).toLocalDate().coerceAtLeast(start)
+    val first = start.coerceAtLeast(today)
+    if (first <= end && first < today.plusDays(days)) first else null
+} catch (_: Exception) { null }
+
+fun reminderMillis(event: Event, minutes: Int, zone: ZoneId = ZoneId.systemDefault()): Long {
+    require(minutes in listOf(0, 5, 15, 30, 60, 1440))
+    return eventStartMillis(event, zone) - minutes * 60000L
+}
+
+enum class ReminderUpdate { REMOVE, RESCHEDULE, METADATA_ONLY }
+fun reminderUpdate(created: String, start: String, allDay: Boolean, event: Event?): ReminderUpdate = when {
+    event == null || event.createdAt != created -> ReminderUpdate.REMOVE
+    event.start != start || event.allDay != allDay -> ReminderUpdate.RESCHEDULE
+    else -> ReminderUpdate.METADATA_ONLY
+}
