+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+object PersonalSync {
+    const val WORK = "selfmailer-personal-data"
+    fun configure(ctx: Context) {
+        val prefs = Prefs(ctx); val data = prefs.personalState()
+        val wm = WorkManager.getInstance(ctx)
+        if (!prefs.personalVerified || (!data.optBoolean("contact_auto") && data.optJSONObject("reminders")?.length().orZero() == 0)) {
+            wm.cancelUniqueWork(WORK); return
+        }
+        val request = PeriodicWorkRequestBuilder<PersonalSyncWorker>(1, TimeUnit.HOURS)
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build()).build()
+        wm.enqueueUniquePeriodicWork(WORK, ExistingPeriodicWorkPolicy.UPDATE, request)
+    }
+    fun stop(ctx: Context) { WorkManager.getInstance(ctx).cancelUniqueWork(WORK); CalendarReminders.cancelAll(ctx) }
+}
+private fun Int?.orZero() = this ?: 0
+
+class PersonalSyncWorker(ctx: Context, params: WorkerParameters) : CoroutineWorker(ctx, params) {
+    override suspend fun doWork(): Result = withContext(Dispatchers.IO) {
+        val prefs = Prefs(applicationContext)
+        val token = prefs.token ?: return@withContext Result.success()
+        val user = prefs.personalUserId
+        val identity = prefs.personalIdentity
+        val server = prefs.serverUrl
+        val api = Api(server).also { it.token = token }
+        fun current() = prefs.token == token && prefs.serverUrl == server && prefs.personalUserId == user && prefs.personalVerified
+        try {
+            if (!current()) return@withContext Result.success()
+            val me = api.me()
+            if (me.getInt("id") != user || me.optString("created_at") != identity) {
+                prefs.pausePersonalToken(token); return@withContext Result.success()
+            }
+            val state = prefs.personalState()
+            if (state.optBoolean("contact_auto")) {
+                if (ContextCompat.checkSelfPermission(applicationContext, Manifest.permission.READ_CONTACTS) != PackageManager.PERMISSION_GRANTED) {
+                    prefs.updatePersonalState(token) { it.put("sync_summary", "Automatischer Kontaktabgleich pausiert: Kontaktzugriff fehlt.") }
+                } else {
+                    val selected = MessageHeader.strList(state, "contact_keys").toSet()
+                    val phone = readPhoneContacts(applicationContext).filter { it.key in selected }
+                    val device = contactDeviceId(prefs, token)
+                    var changed = 0; var conflicts = 0
+                    for (chunk in phone.chunked(200)) {
+                        if (!current() || !prefs.personalState().optBoolean("contact_auto")) return@withContext Result.success()
+                        val allowed = MessageHeader.strList(prefs.personalState(), "contact_keys").toSet()
+                        val fingerprints = prefs.personalState().optJSONObject("contact_fingerprints")
+                        val changedEntries = chunk.filter { it.key in allowed && fingerprints?.optString(it.key) != it.fingerprint() }
+                        val entries = changedEntries.map { it.payload() }
+                        if (entries.isEmpty()) continue
+                        val result = api.phoneContacts(device, entries, false, linkedOnly = true)
+                        changed += result.optInt("changed")
+                        val rows = result.getJSONArray("items")
+                        conflicts += (0 until rows.length()).count { rows.getJSONObject(it).optString("status") !in safePhoneStatuses }
+                        val accepted = MessageHeader.strList(result, "linked_source_keys").toSet()
+                        prefs.updatePersonalState(token) { data ->
+                            val hashes = data.optJSONObject("contact_fingerprints") ?: org.json.JSONObject()
+                            changedEntries.filter { it.key in accepted }.forEach { hashes.put(it.key, it.fingerprint()) }
+                            data.put("contact_fingerprints", hashes)
+                        }
+                    }
+                    val missing = selected.size - phone.size
+                    prefs.updatePersonalState(token) { it.put("contact_sync_at", System.currentTimeMillis())
+                        .put("sync_summary", "Automatisch: $changed geändert, $conflicts zur Prüfung, $missing auf dem Handy entfernt/nicht gefunden. Keine Löschungen übernommen.") }
+                }
+            }
+            if (current() && prefs.personalState().optJSONObject("reminders")?.length().orZero() > 0) {
+                val ids = prefs.personalState().getJSONObject("reminders").keys().asSequence().mapNotNull { it.toIntOrNull() }.toList()
+                if (ids.isEmpty()) return@withContext Result.success()
+                val events = api.reminderEvents(ids)
+                if (current()) CalendarReminders.reconcile(applicationContext, events, token)
+            }
+            Result.success()
+        } catch (e: kotlinx.coroutines.CancellationException) { throw e }
+        catch (e: ApiException) {
+            if (e.status == 401) prefs.withPersonalToken(token, prefs.personalScope) { CalendarReminders.cancelAll(applicationContext) }
+            prefs.updatePersonalState(token) { it.put("sync_summary", if (e.status == 401) "Bitte neu anmelden; automatischer Abgleich pausiert." else "Abgleich fehlgeschlagen; vorhandene Daten bleiben erhalten.") }
+            if (e.status == 401) prefs.pausePersonalToken(token)
+            if (e.status == 401) Result.success() else Result.retry()
+        } catch (_: Exception) {
+            prefs.updatePersonalState(token) { it.put("sync_summary", "Abgleich fehlgeschlagen; vorhandene Daten bleiben erhalten.") }
+            Result.retry()
+        }
+    }
+}
+
+class PersonalBootReceiver : android.content.BroadcastReceiver() {
+    override fun onReceive(ctx: Context, intent: android.content.Intent) {
+        if (intent.action in listOf(android.content.Intent.ACTION_BOOT_COMPLETED, android.content.Intent.ACTION_TIMEZONE_CHANGED, android.content.Intent.ACTION_TIME_CHANGED)) {
+            CalendarReminders.restore(ctx); PersonalSync.configure(ctx)
+        }
+    }
+}
