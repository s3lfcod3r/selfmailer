+package com.selfmailer.app
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.util.Base64
+
+class ComposeDraftTest {
+    private fun draft() = ComposeDraft(7, "Person <to@example.org>", "copy@example.org", "Grüße ☕",
+        "Erste Zeile\nZweite Zeile", "<original@example.org>", "\n> älteres Zitat", "<blockquote>Zitat</blockquote>", false,
+        Identity(3, 7, "Alias", "alias@example.org", "Signatur", false), "\n-- Signatur", 3, 12, 190)
+
+    @Test fun restoreKeepsAllSenderReplyAndEditorState() {
+        val before = draft()
+        assertEquals(before, ComposeDraft.decode(before.encode()))
+    }
+    @Test fun largeDraftAndQuoteSurviveWithoutBundleTruncation() {
+        val before = draft().copy(body = "ä".repeat(600_000), quotedHtml = "<p>" + "z".repeat(300_000) + "</p>")
+        assertEquals(before, ComposeDraft.decode(before.encode()))
+    }
+    @Test fun missingOrCorruptStorageDoesNotCreateAnEmptyReplacement() {
+        assertNull(ComposeDraft.decode(null))
+        assertNull(ComposeDraft.decode("not base64!"))
+        val bytes = Base64.getDecoder().decode(draft().encode())
+        assertNull(ComposeDraft.decode(Base64.getEncoder().encodeToString(bytes.copyOf(30))))
+        bytes[3] = 99
+        assertNull(ComposeDraft.decode(Base64.getEncoder().encodeToString(bytes)))
+    }
+    @Test fun appendedGarbageIsRejected() {
+        val bytes = Base64.getDecoder().decode(draft().encode()) + byteArrayOf(1)
+        assertNull(ComposeDraft.decode(Base64.getEncoder().encodeToString(bytes)))
+    }
+    @Test fun invalidEditorPositionsAreClampedWithoutChangingText() {
+        val restored = ComposeDraft.decode(draft().copy(selectionStart = -1, selectionEnd = 999, scroll = -3).encode())!!
+        assertEquals(0, restored.selectionStart)
+        assertEquals(restored.body.length, restored.selectionEnd)
+        assertEquals(0, restored.scroll)
+    }
+    @Test fun absentIdentityAndDeletedAccountDoNotInventAnotherSender() {
+        val before = draft().copy(accountId = null, identity = null)
+        assertEquals(before, ComposeDraft.decode(before.encode()))
+        assertNull(ComposeDraft.decode(before.encode())!!.accountId)
+    }
+    @Test(expected = IllegalArgumentException::class)
+    fun oversizedPayloadIsRejectedInsteadOfTruncated() {
+        draft().copy(body = "x".repeat(8 * 1024 * 1024 + 1)).encode()
+    }
+    @Test fun unlockingRestoresComposeAndThreadWithoutOpeningProtectedInvalidRoutes() {
+        assertEquals("compose", unlockedDestination("compose"))
+        assertEquals("thread", unlockedDestination("thread"))
+        assertEquals("read", unlockedDestination("read"))
+        assertEquals("shell", unlockedDestination("login"))
+        assertEquals("shell", unlockedDestination("locked"))
+    }
+}
