+package com.selfmailer.app
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.util.Base64
+
+/** Payload is stored only in the existing encrypted preferences, never in an Intent/Bundle. */
+data class ComposeDraft(
+    val accountId: Int?, val to: String, val cc: String, val subject: String, val body: String,
+    val inReplyTo: String, val quotedText: String, val quotedHtml: String, val showQuote: Boolean,
+    val identity: Identity?, val signature: String, val selectionStart: Int, val selectionEnd: Int,
+    val scroll: Int,
+) {
+    fun encode(): String {
+        val bytes = ByteArrayOutputStream()
+        DataOutputStream(bytes).use { out ->
+            out.writeInt(1)
+            out.writeInt(accountId ?: -1)
+            fun text(value: String) {
+                val encoded = value.toByteArray(Charsets.UTF_8)
+                require(encoded.size <= MAX_BYTES) { "Entwurf zu groß" }
+                out.writeInt(encoded.size); out.write(encoded)
+            }
+            listOf(to, cc, subject, body, inReplyTo, quotedText, quotedHtml, signature).forEach(::text)
+            out.writeBoolean(showQuote)
+            out.writeBoolean(identity != null)
+            identity?.let { i ->
+                out.writeInt(i.id); out.writeInt(i.accountId)
+                listOf(i.name, i.email, i.signature).forEach(::text)
+                out.writeBoolean(i.isDefault)
+            }
+            out.writeInt(selectionStart); out.writeInt(selectionEnd); out.writeInt(scroll)
+        }
+        require(bytes.size() <= MAX_BYTES) { "Entwurf zu groß" }
+        return Base64.getEncoder().encodeToString(bytes.toByteArray())
+    }
+
+    companion object {
+        private const val MAX_BYTES = 8 * 1024 * 1024
+        fun decode(encoded: String?): ComposeDraft? = try {
+            if (encoded == null || encoded.length > (MAX_BYTES * 4 / 3 + 8)) null else {
+                val bytes = Base64.getDecoder().decode(encoded)
+                require(bytes.size <= MAX_BYTES)
+                DataInputStream(ByteArrayInputStream(bytes)).use { input ->
+                    require(input.readInt() == 1)
+                    val account = input.readInt().takeIf { it > 0 }
+                    fun text(): String {
+                        val length = input.readInt()
+                        require(length in 0..input.available())
+                        val data = ByteArray(length); input.readFully(data)
+                        return data.toString(Charsets.UTF_8)
+                    }
+                    val fields = List(8) { text() }
+                    val quote = input.readBoolean()
+                    val identity = if (input.readBoolean()) Identity(input.readInt(), input.readInt(), text(), text(), text(), input.readBoolean()) else null
+                    val start = input.readInt().coerceIn(0, fields[3].length)
+                    val end = input.readInt().coerceIn(0, fields[3].length)
+                    val scroll = input.readInt().coerceAtLeast(0)
+                    require(input.available() == 0)
+                    ComposeDraft(account, fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], quote, identity, fields[7], start, end, scroll)
+                }
+            }
+        } catch (_: Exception) { null }
+    }
+}
+
+/** Locking hides the UI; it must not change the user's navigation destination. */
+fun unlockedDestination(previous: String): String =
+    previous.takeIf { it in setOf("shell", "read", "thread", "pdf", "compose", "settings", "notifyfolders") } ?: "shell"
