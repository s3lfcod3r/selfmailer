+        MessageHeader(uid, subject, from, "Mon, 12 Oct 2026 12:${uid.padStart(2, '0')}:00 +0200", seen, flagged,
+            "Projekt mit Beispiel", false, mid, reply, refs, "INBOX", uidValidity = 20)
+
+    @Test fun filtersCombineAndKeepWorkingWithoutTheSearchPanel() {
+        val filters = MailFilters(unread = true, starred = true)
+        assertTrue(filters.matches(mail("1", seen = false, flagged = true)))
+        assertFalse(filters.matches(mail("2", seen = false)))
+        assertFalse(filters.matches(mail("3", flagged = true)))
+    }
+    @Test fun searchFindsWordsAcrossSenderSubjectAndSnippet() {
+        assertTrue(MailFilters(" PERSON   projekt ").matches(mail("1")))
+        assertFalse(MailFilters("person fehlt").matches(mail("1")))
+        assertTrue(MailFilters(attachment = true).matches(mail("1").copy(hasAttachments = true)))
+        assertFalse(MailFilters(attachment = true).matches(mail("1")))
+    }
+    @Test fun resetShowsEveryMessageAndLabelsRemainIndependent() {
+        assertFalse(MailFilters().active)
+        assertTrue(MailFilters().matches(mail("1")))
+        assertTrue(MailFilters(label = "work").matches(mail("1").copy(labels = listOf("work"))))
+        assertFalse(MailFilters(label = "work").matches(mail("1")))
+    }
+    @Test fun filteredConversationKeepsReadRepliesForContext() {
+        val root = mail("1", seen = false)
+        val reply = mail("2", subject = "Re: Termin", reply = root.messageId)
+        val conv = groupThreads(listOf(reply, root), emptySet(), "Ich").single()
