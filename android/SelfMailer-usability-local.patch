+package com.selfmailer.app
+
+data class MailFilters(val query: String = "", val unread: Boolean = false, val starred: Boolean = false, val attachment: Boolean = false, val label: String? = null) {
+    val active: Boolean get() = query.isNotBlank() || unread || starred || attachment || label != null
+    fun matches(message: MessageHeader): Boolean {
+        val words = query.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+        val text = listOf(message.from, message.subject, message.snippet).joinToString(" ")
+        return words.all { text.contains(it, ignoreCase = true) } &&
+            (!unread || !message.seen) && (!starred || message.flagged) &&
+            (!attachment || message.hasAttachments) && (label == null || label in message.labels)
+    }
+    // Keep the other messages in a matching conversation visible as context.
+    fun matches(conversation: Conv): Boolean = conversation.messages.any(::matches)
+}
+
+fun mailListContext(accountId: Int?, folder: String, filters: MailFilters, conversations: Boolean, unified: Boolean, generation: Long = 0): String =
+    listOf(if (unified) "unified" else accountId.toString(), if (unified) "" else folder,
+        filters.query, filters.unread.toString(), filters.starred.toString(), filters.attachment.toString(),
+        filters.label ?: "", conversations.toString(), if (unified) "0" else generation.toString())
+        .joinToString("") { "${it.length}:$it" }
+
+fun groupUnifiedConversations(rows: List<UnifiedMsg>, ownEmails: Set<String>, meLabel: String): List<Pair<UnifiedMsg, Conv>> =
+    rows.groupBy { it.accountId }.values.flatMap { accountRows ->
+        groupThreads(accountRows.map { it.header }, ownEmails, meLabel).map { conv ->
+            accountRows.first().copy(header = conv.latest) to conv
+        }
+    }.sortedBy { (row, conv) ->
+        rows.indexOfFirst { it.accountId == row.accountId && conv.messages.any { m ->
+            m.uid == it.header.uid && m.folder == it.header.folder && m.uidValidity == it.header.uidValidity
+        } }
+    }
