+package com.selfmailer.app
+
+import android.Manifest
+import android.content.ContentProviderOperation
+import android.content.Context
+import android.content.pm.PackageManager
+import android.provider.ContactsContract
+import android.provider.ContactsContract.CommonDataKinds as Kinds
+import android.provider.ContactsContract.Data as Data
+import android.provider.ContactsContract.RawContacts as Raw
+import androidx.core.content.ContextCompat
+
+private const val EXPORT_MIME = "vnd.android.cursor.item/vnd.com.selfmailer.export"
+private val phoneExportLock = Any()
+fun <T> withPhoneExportLock(block: () -> T): T = synchronized(phoneExportLock, block)
+
+fun BookContact.exportContact(): ExportContact {
+    fun value(key: String) = if (raw.isNull(key)) "" else raw.optString(key).trim()
+    val emails = allEmails.map { it.trim() }.filter { it.isNotEmpty() }.distinctBy(::exportEmailIdentity)
+    val phones = (listOf(mobile to Kinds.Phone.TYPE_MOBILE, work to Kinds.Phone.TYPE_WORK, phone to Kinds.Phone.TYPE_HOME) +
+        extraPhones.map { it to Kinds.Phone.TYPE_OTHER }).map { it.first.trim() to it.second }.filter { it.first.isNotEmpty() }.distinctBy { phoneIdentity(it.first) }
+    require(emails.size <= 201 && phones.size <= 203) { "Zu viele Adressen oder Nummern im Kontakt" }
+    val contact = ExportContact(id, first.trim(), last.trim(), emails, phones, organization.trim(), value("title"), value("website"),
+        value("street"), value("postal_code"), value("city"), value("country"), value("notes"), value("birthday"))
+    require(contact.toString().toByteArray(Charsets.UTF_8).size <= 150000) { "Kontakt ist zu groß für einen sicheren Handyexport" }
+    return contact
+}
+
+class AndroidPhoneExportBook(private val ctx: Context, private val prefs: Prefs, private val token: String, private val scope: String) : PhoneExportBook {
+    private fun readable() = check(ContextCompat.checkSelfPermission(ctx, Manifest.permission.READ_CONTACTS) == PackageManager.PERMISSION_GRANTED) { "Kontaktzugriff nicht erlaubt" }
+    override fun snapshot(): PhoneExportSnapshot {
+        readable()
+        val entries = readPhoneContacts(ctx, importLimits = false)
+        val markers = mutableSetOf<String>()
+        ctx.contentResolver.query(Data.CONTENT_URI, arrayOf(Data.DATA1), "${Data.MIMETYPE}=?", arrayOf(EXPORT_MIME), null)?.use { cursor ->
+            while (cursor.moveToNext()) {
+                check(markers.size < 20000) { "Zu viele Exportkennungen; Prüfung abgebrochen" }
+                cursor.getString(0)?.let { markers += it }
+            }
+        } ?: error("Exportkennungen konnten nicht vollständig gelesen werden")
+        return PhoneExportSnapshot(entries, markers)
+    }
+    override fun insert(contact: ExportContact, marker: String) {
+        readable()
+        check(ContextCompat.checkSelfPermission(ctx, Manifest.permission.WRITE_CONTACTS) == PackageManager.PERMISSION_GRANTED) { "Schreibzugriff auf Kontakte nicht erlaubt" }
+        val operations = arrayListOf<ContentProviderOperation>()
+        operations += ContentProviderOperation.newAssertQuery(Data.CONTENT_URI)
+            .withSelection("${Data.MIMETYPE}=? AND ${Data.DATA1}=?", arrayOf(EXPORT_MIME, marker)).withExpectedCount(0).build()
+        val rawIndex = operations.size
+        // Android chooses its default contact storage; the UI discloses possible cloud synchronization.
+        operations += ContentProviderOperation.newInsert(Raw.CONTENT_URI).build()
+        fun row(mime: String, fields: Map<String, Any>) {
+            val operation = ContentProviderOperation.newInsert(Data.CONTENT_URI).withValueBackReference(Data.RAW_CONTACT_ID, rawIndex).withValue(Data.MIMETYPE, mime)
+            fields.forEach { (key, value) -> operation.withValue(key, value) }; operations += operation.build()
+        }
+        row(Kinds.StructuredName.CONTENT_ITEM_TYPE, mapOf(Kinds.StructuredName.GIVEN_NAME to contact.first,
+            Kinds.StructuredName.FAMILY_NAME to contact.last, Kinds.StructuredName.DISPLAY_NAME to contact.label))
+        contact.emails.forEach { row(Kinds.Email.CONTENT_ITEM_TYPE, mapOf(Kinds.Email.ADDRESS to it, Kinds.Email.TYPE to Kinds.Email.TYPE_OTHER)) }
+        contact.phones.forEach { row(Kinds.Phone.CONTENT_ITEM_TYPE, mapOf(Kinds.Phone.NUMBER to it.first, Kinds.Phone.TYPE to it.second)) }
+        if (contact.organization.isNotBlank() || contact.title.isNotBlank()) row(Kinds.Organization.CONTENT_ITEM_TYPE,
+            mapOf(Kinds.Organization.COMPANY to contact.organization, Kinds.Organization.TITLE to contact.title, Kinds.Organization.TYPE to Kinds.Organization.TYPE_WORK))
+        if (contact.website.isNotBlank()) row(Kinds.Website.CONTENT_ITEM_TYPE, mapOf(Kinds.Website.URL to contact.website, Kinds.Website.TYPE to Kinds.Website.TYPE_OTHER))
+        if (listOf(contact.street, contact.postal, contact.city, contact.country).any { it.isNotBlank() }) row(Kinds.StructuredPostal.CONTENT_ITEM_TYPE,
+            mapOf(Kinds.StructuredPostal.STREET to contact.street, Kinds.StructuredPostal.POSTCODE to contact.postal,
+                Kinds.StructuredPostal.CITY to contact.city, Kinds.StructuredPostal.COUNTRY to contact.country, Kinds.StructuredPostal.TYPE to Kinds.StructuredPostal.TYPE_HOME))
+        if (contact.notes.isNotBlank()) row(Kinds.Note.CONTENT_ITEM_TYPE, mapOf(Kinds.Note.NOTE to contact.notes))
+        if (contact.birthday.isNotBlank()) row(Kinds.Event.CONTENT_ITEM_TYPE, mapOf(Kinds.Event.START_DATE to contact.birthday, Kinds.Event.TYPE to Kinds.Event.TYPE_BIRTHDAY))
+        row(EXPORT_MIME, mapOf(Data.DATA1 to marker))
+        var saved = false
+        prefs.withPersonalToken(token, scope) {
+            val result = ctx.contentResolver.applyBatch(ContactsContract.AUTHORITY, operations)
+            check(result.size == operations.size && result[rawIndex].uri != null) { "Handyexport nicht bestätigt; vor erneutem Versuch neu prüfen" }
+            saved = true
+        }
+        check(saved) { "Sitzung geändert; Export gestoppt" }
+    }
+}
