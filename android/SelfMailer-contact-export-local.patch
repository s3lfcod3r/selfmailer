+package com.selfmailer.app
+
+import java.util.Locale
+import java.security.MessageDigest
+
+data class ExportContact(val id: Int, val first: String, val last: String, val emails: List<String>,
+    val phones: List<Pair<String, Int>>, val organization: String = "", val title: String = "", val website: String = "",
+    val street: String = "", val postal: String = "", val city: String = "", val country: String = "",
+    val notes: String = "", val birthday: String = "") {
+    val label get() = contactLabel(first, last, emails.firstOrNull().orEmpty())
+    fun phoneEntry(key: String) = PhoneEntry(key, first, last, emails, phones, organization)
+}
+
+enum class ExportStatus(val label: String) {
+    NEW("Neu — aufs Handy übernehmen"), EXISTS("Bereits vorhanden — überspringen"),
+    AMBIGUOUS("Mehrere Handytreffer — überspringen"), NAME_MATCH("Gleicher Name — manuell prüfen"),
+    DUPLICATE_SELECTION("Doppelt in der Auswahl — überspringen"), EMPTY("Keine exportierbaren Angaben"),
+    CHANGED("Serverkontakt geändert — neu prüfen"), FAILED("Export angehalten — neu prüfen")
+}
+data class ExportPreview(val contact: ExportContact, val status: ExportStatus, val matches: List<String> = emptyList())
+data class PhoneExportSnapshot(val entries: List<PhoneEntry>, val markers: Set<String>)
+
+fun exportEmailIdentity(value: String) = value.trim().lowercase(Locale.ROOT)
+private fun exportIdentifiers(entry: PhoneEntry): Set<String> =
+    entry.emails.map(::exportEmailIdentity).filter { it.isNotEmpty() }.map { "e:$it" }.toSet() +
+    entry.phones.map { phoneIdentity(it.first) }.filter { it.count(Char::isDigit) >= 7 }.map { "p:$it" }.toSet()
+private fun exportName(first: String, last: String) = "$first $last".trim().replace(Regex("\\s+"), " ").lowercase(Locale.ROOT)
+
+fun exportMarker(scope: String, contact: ExportContact): String {
+    // Length prefixes keep separators inside user data unambiguous; no login token is stored in Contacts.
+    val fields = listOf(scope, contact.id.toString(), contact.first, contact.last, contact.emails.size.toString(), contact.phones.size.toString()) +
+        contact.emails + contact.phones.flatMap { listOf(it.first, it.second.toString()) } +
+        listOf(contact.organization, contact.title, contact.website, contact.street, contact.postal, contact.city,
+            contact.country, contact.notes, contact.birthday)
+    val value = fields.joinToString("") { "${it.length}:$it" }
+    return MessageDigest.getInstance("SHA-256").digest(value.toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) }
+}
+
+fun exportPreview(contacts: List<ExportContact>, snapshot: PhoneExportSnapshot, scope: String): List<ExportPreview> {
+    val identifiers = mutableMapOf<String, MutableList<PhoneEntry>>()
+    val namesByValue = mutableMapOf<String, MutableList<PhoneEntry>>()
+    snapshot.entries.forEach { entry ->
+        exportIdentifiers(entry).forEach { identifiers.getOrPut(it) { mutableListOf() } += entry }
+        val name = exportName(entry.first, entry.last)
+        if (name.isNotEmpty()) namesByValue.getOrPut(name) { mutableListOf() } += entry
+    }
+    val selectedIds = mutableSetOf<String>(); val selectedNames = mutableSetOf<String>()
+    val seenIds = mutableSetOf<Int>()
+    return contacts.map { contact ->
+        val entry = contact.phoneEntry("source:${contact.id}"); val ids = exportIdentifiers(entry)
+        val name = exportName(contact.first, contact.last)
+        val strong = ids.flatMap { identifiers[it].orEmpty() }.distinctBy { it.key }
+        val names = namesByValue[name].orEmpty()
+        val repeated = !seenIds.add(contact.id) || (ids intersect selectedIds).isNotEmpty() || (name.isNotEmpty() && name in selectedNames)
+        val meaningful = name.isNotEmpty() || contact.emails.any { it.isNotBlank() } || contact.phones.any { it.first.isNotBlank() } || contact.organization.isNotBlank()
+        val status = when {
+            exportMarker(scope, contact) in snapshot.markers -> ExportStatus.EXISTS
+            !meaningful -> ExportStatus.EMPTY
+            strong.size > 1 -> ExportStatus.AMBIGUOUS
+            strong.size == 1 -> ExportStatus.EXISTS
+            names.isNotEmpty() -> ExportStatus.NAME_MATCH
+            repeated -> ExportStatus.DUPLICATE_SELECTION
+            else -> ExportStatus.NEW
+        }
+        selectedIds += ids; if (name.isNotEmpty()) selectedNames += name
+        ExportPreview(contact, status, (if (strong.isNotEmpty()) strong else names).map { contactLabel(it.first, it.last, it.emails.firstOrNull().orEmpty()) })
+    }
+}
+
+interface PhoneExportBook {
+    fun snapshot(): PhoneExportSnapshot
+    fun insert(contact: ExportContact, marker: String)
+}
+data class ExportResult(val added: Int, val rows: List<ExportPreview>, val error: String? = null)
+fun exportToPhone(approved: List<ExportContact>, scope: String, book: PhoneExportBook,
+                  verifySource: (ExportContact) -> Boolean, beforeWrite: () -> Unit = {}, progress: (Int) -> Unit = {}): ExportResult {
+    require(approved.size <= 200)
+    var added = 0; val results = mutableListOf<ExportPreview>()
+    for ((index, contact) in approved.withIndex()) {
+        beforeWrite()
+        try {
+            if (!verifySource(contact)) { results += ExportPreview(contact, ExportStatus.CHANGED); progress(index + 1); continue }
+            // Refresh before every write; edits and imports since the preview must also be considered.
+            val row = exportPreview(listOf(contact), book.snapshot(), scope).single()
+            if (row.status == ExportStatus.NEW) {
+                beforeWrite(); book.insert(contact, exportMarker(scope, contact)); added++
+            }
+            results += row; progress(index + 1)
+        } catch (e: kotlinx.coroutines.CancellationException) { throw e }
+        catch (e: Exception) {
+            results += ExportPreview(contact, ExportStatus.FAILED)
+            return ExportResult(added, results, e.message ?: "Handyexport fehlgeschlagen")
+        }
+    }
+    return ExportResult(added, results)
+}
