+        }
+    }, confirmButton = {
+        TextButton(enabled = !busy && selected.isNotEmpty() && (previews == null || safe > 0), onClick = {
+            if (previews == null) {
+                if (ContextCompat.checkSelfPermission(ctx, Manifest.permission.READ_CONTACTS) == PackageManager.PERMISSION_GRANTED) preview()
+                else readPermission.launch(Manifest.permission.READ_CONTACTS)
+            } else if (!confirmed) confirmed = true
+            else if (ContextCompat.checkSelfPermission(ctx, Manifest.permission.WRITE_CONTACTS) == PackageManager.PERMISSION_GRANTED) export()
+            else writePermission.launch(Manifest.permission.WRITE_CONTACTS)
+        }) { Text(if (previews == null) "Auswahl prüfen" else if (confirmed) "Export bestätigen" else "Neue exportieren …") }
+    }, dismissButton = { TextButton(enabled = !busy, onClick = onClose) { Text("Schließen") } })
+}
