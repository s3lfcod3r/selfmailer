+package com.selfmailer.app
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class PhoneExportTest {
+    private fun contact(id: Int = 1, first: String = "Anna", last: String = "Example", emails: List<String> = listOf("anna@example.org"),
+        phones: List<Pair<String, Int>> = listOf("+49 123456789" to 2)) = ExportContact(id, first, last, emails, phones)
+    private fun phone(key: String = "one", first: String = "Anna", last: String = "Example", emails: List<String> = listOf("anna@example.org"),
+        phones: List<Pair<String, Int>> = listOf("0049 (123) 456789" to 2)) = PhoneEntry(key, first, last, emails, phones, "")
+    private fun status(source: ExportContact, vararg target: PhoneEntry) = exportPreview(listOf(source), PhoneExportSnapshot(target.toList(), emptySet()), "owner").single().status
+    private class Book : PhoneExportBook {
+        val entries = mutableListOf<PhoneEntry>(); val markers = mutableSetOf<String>(); var writes = 0
+        var failAt = 0; var saveThenFail = false; var readFails = false
+        override fun snapshot(): PhoneExportSnapshot { if (readFails) error("permission lost"); return PhoneExportSnapshot(entries.toList(), markers.toSet()) }
+        override fun insert(contact: ExportContact, marker: String) {
+            if (failAt == writes + 1 && !saveThenFail) error("write failed")
+            entries += contact.phoneEntry("saved:${contact.id}"); markers += marker; writes++
+            if (saveThenFail) { saveThenFail = false; error("unknown response") }
+        }
+    }
+    @Test fun newContactsAreOnlyWrittenAfterExplicitApply() {
+        val book = Book(); assertEquals(ExportStatus.NEW, exportPreview(listOf(contact()), book.snapshot(), "owner").single().status)
+        assertEquals(0, book.writes)
+        assertEquals(1, exportToPhone(listOf(contact()), "owner", book, { true }).added)
+    }
+    @Test fun emailCaseAndSecondaryEmailsMatch() {
+        assertEquals(ExportStatus.EXISTS, status(contact(emails=listOf("other@x", " ANNA@example.org ")), phone(emails=listOf("anna@EXAMPLE.ORG"))))
+    }
+    @Test fun emailIdentityIsIndependentOfDeviceLanguage() {
+        val previous = java.util.Locale.getDefault()
+        try {
+            java.util.Locale.setDefault(java.util.Locale.forLanguageTag("tr-TR"))
+            assertEquals("info@example.org", exportEmailIdentity(" INFO@EXAMPLE.ORG "))
+        } finally { java.util.Locale.setDefault(previous) }
+    }
+    @Test fun internationalPhoneFormattingMatches() {
+        assertEquals(ExportStatus.EXISTS, status(contact(emails=emptyList()), phone(first="Other", emails=emptyList())))
+    }
+    @Test fun nationalCountryCodesAreNotGuessed() {
+        assertEquals(ExportStatus.NEW, status(contact(emails=emptyList(), phones=listOf("0123456789" to 2)), phone(first="Other", emails=emptyList())))
+    }
+    @Test fun shortNumbersDoNotMergePeople() {
+        assertEquals(ExportStatus.NEW, status(contact(emails=emptyList(),phones=listOf("1234" to 1)), phone(first="Other", emails=emptyList(),phones=listOf("1234" to 1))))
+    }
+    @Test fun conflictingIdentifiersAcrossTwoPeopleAreAmbiguous() {
+        assertEquals(ExportStatus.AMBIGUOUS, status(contact(), phone(key="email", phones=emptyList()), phone(key="phone", first="Other", emails=emptyList())))
+    }
+    @Test fun sameNameOnlyNeedsManualReview() {
+        assertEquals(ExportStatus.NAME_MATCH, status(contact(), phone(first=" Anna   Example ",last="", emails=emptyList(), phones=emptyList())))
+    }
+    @Test fun duplicateSelectionDoesNotWriteTwice() {
+        val book = Book(); val first=contact(); val second=contact(id=2,first="Different")
+        assertEquals(listOf(ExportStatus.NEW,ExportStatus.DUPLICATE_SELECTION), exportPreview(listOf(first,second),book.snapshot(),"owner").map { it.status })
+        assertEquals(1,exportToPhone(listOf(first,second),"owner",book,{true}).added);assertEquals(1,book.writes)
+    }
+    @Test fun identicalNamesInSelectionAreConservative() {
+        val rows=exportPreview(listOf(contact(emails=emptyList(),phones=emptyList()),contact(id=2,emails=emptyList(),phones=emptyList())),PhoneExportSnapshot(emptyList(),emptySet()),"owner")
+        assertEquals(ExportStatus.DUPLICATE_SELECTION,rows.last().status)
+    }
+    @Test fun contactsWithoutMeaningfulIdentityAreNotExported() {
+        val source=contact(first="",last="",emails=emptyList(),phones=emptyList()).copy(notes="Only notes")
+        assertEquals(ExportStatus.EMPTY,status(source))
+    }
+    @Test fun repeatedExportIsIdempotent() {
+        val book=Book();exportToPhone(listOf(contact()),"owner",book,{true})
+        assertEquals(0,exportToPhone(listOf(contact()),"owner",book,{true}).added);assertEquals(1,book.writes)
+    }
+    @Test fun markerAlsoProtectsNameOnlyContactEditedOnPhone() {
+        val source=contact(emails=emptyList(),phones=emptyList());val marker=exportMarker("owner",source)
+        assertEquals(ExportStatus.EXISTS,exportPreview(listOf(source),PhoneExportSnapshot(listOf(phone(first="Renamed",emails=emptyList(),phones=emptyList())),setOf(marker)),"owner").single().status)
+    }
+    @Test fun scopeAndIdentityBoundMarker() {
+        assertNotEquals(exportMarker("owner",contact()),exportMarker("other",contact()))
+        assertNotEquals(exportMarker("owner",contact()),exportMarker("owner",contact(id=2)))
+        assertEquals(64,exportMarker("owner",contact()).length)
+    }
+    @Test fun markerSeparatesVariableListsAndEmbeddedDelimiters() {
+        assertNotEquals(exportMarker("owner",contact(emails=listOf("a","b"))),exportMarker("owner",contact(emails=listOf("a:b"))))
+        assertNotEquals(exportMarker("owner",contact(emails=listOf("x")).copy(organization="")),exportMarker("owner",contact(emails=emptyList()).copy(organization="x")))
+    }
+    @Test fun changedServerDataIsNotAppliedFromStalePreview() {
+        val book=Book(); val outcome=exportToPhone(listOf(contact()),"owner",book,{false})
+        assertEquals(ExportStatus.CHANGED,outcome.rows.single().status);assertEquals(0,book.writes)
+    }
+    @Test fun phoneChangesAfterPreviewAreDetectedBeforeApply() {
+        val book=Book(); assertEquals(ExportStatus.NEW,exportPreview(listOf(contact()),book.snapshot(),"owner").single().status)
+        book.entries += phone(); assertEquals(0,exportToPhone(listOf(contact()),"owner",book,{true}).added)
+    }
+    @Test fun failedPermissionReadNeverWrites() {
+        val book=Book();book.readFails=true
+        val result=exportToPhone(listOf(contact()),"owner",book,{true});assertNotNull(result.error);assertEquals(0,book.writes)
+    }
+    @Test fun partialFailureStopsAndRetryKeepsCompletedContacts() {
+        val book=Book();book.failAt=2
+        val sources=listOf(contact(),contact(id=2,first="Ben",emails=listOf("ben@example.org"),phones=emptyList()),contact(id=3,first="Chris",emails=listOf("chris@example.org"),phones=emptyList()))
+        val result=exportToPhone(sources,"owner",book,{true});assertEquals(1,result.added);assertNotNull(result.error);assertEquals(1,book.writes)
+        book.failAt=0;assertEquals(2,exportToPhone(sources,"owner",book,{true}).added);assertEquals(3,book.writes)
+    }
+    @Test fun unknownWriteResponseIsNotBlindlyRepeated() {
+        val book=Book();book.saveThenFail=true
+        assertNotNull(exportToPhone(listOf(contact()),"owner",book,{true}).error)
+        assertEquals(0,exportToPhone(listOf(contact()),"owner",book,{true}).added);assertEquals(1,book.writes)
+    }
+    @Test fun sessionChangeBeforeWriteStopsExport() {
+        val book=Book();var checks=0
+        val result=exportToPhone(listOf(contact()),"owner",book,{true},beforeWrite={checks++;if(checks==2)error("logout")})
+        assertNotNull(result.error)
+        assertEquals(0,book.writes)
+    }
+    @Test fun limitsAndProgressAreExplicit() {
+        val book=Book();val progress=mutableListOf<Int>()
+        exportToPhone(listOf(contact()),"owner",book,{true},progress={progress+=it});assertEquals(listOf(1),progress)
+        try { exportToPhone(List(201){contact(it)},"owner",book,{true});fail("Expected limit") } catch (_: IllegalArgumentException) { }
+    }
+}
