# SelfMailer — Konfiguration. Kopieren nach .env (die echte .env ist git-ignoriert):
#   cp .env.example .env
# Alle Variablen tragen das Präfix SELFMAILER_.

# ---- PFLICHT --------------------------------------------------------------
# Master-Secret, min. 32 Zeichen. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Daraus werden per HKDF ZWEI unabhängige Schlüssel abgeleitet: der für die
# JWT-Signatur und der für die At-Rest-Verschlüsselung der gespeicherten
# Postfach-Passwörter. NIEMALS nachträglich ändern — sonst sind alle
# hinterlegten Zugangsdaten unlesbar. Ohne gültiges Secret startet die App nicht.
SELFMAILER_SECRET=

# ---- Grundeinstellungen ---------------------------------------------------
# Pfad der SQLite-Datenbank. Im Container zeigt /data auf das gemountete Volume.
SELFMAILER_DB_PATH=/data/selfmailer.db

# Öffentliche Basis-URL, z. B. http://192.168.1.10:8090 — wird für die
# abonnierbaren Feed-Links (ICS/vCard) gebraucht. Leer = relative Links.
# Zählt außerdem für den CSRF-Schutz als vertrauenswürdige Herkunft (wichtig
# nur für ältere Browser ohne Sec-Fetch-Site hinter einem Reverse-Proxy).
SELFMAILER_BASE_URL=

# Wenn gesetzt, verlangt das First-Run-Setup zusätzlich diesen Token.
SELFMAILER_ADMIN_TOKEN=

# ---- Benachrichtigungen ---------------------------------------------------
# Firebase-Service-Account-JSON für Google-Push (FCM). Datei in den data-Ordner
# legen. Leer oder Datei fehlt = FCM aus (ntfy und Hintergrund-Prüfung bleiben).
SELFMAILER_FCM_CREDENTIALS=/data/fcm-service-account.json

# ---- Übersetzung (optional) -----------------------------------------------
# URL einer SELBST betriebenen LibreTranslate-Instanz, z. B. http://192.168.1.10:5000
# Leer = Übersetzungs-Funktion aus (der Knopf bleibt ausgeblendet).
SELFMAILER_TRANSLATE_URL=
# Nur nötig, wenn die eigene Instanz einen API-Key verlangt.
SELFMAILER_TRANSLATE_API_KEY=

# ---- Hintergrund-Sync -----------------------------------------------------
# Sekunden zwischen den Mail-Läufen (min. 60). Kleiner = neue Mails und Push
# kommen schneller, kostet aber mehr IMAP-Verbindungen.
SELFMAILER_SYNC_INTERVAL=120
# IMAP IDLE: der Server meldet neue Mails im Posteingang sofort (eine zusätzliche
# Verbindung je Konto). Der Takt oben bleibt als Sicherheitsnetz. 0 = aus.
SELFMAILER_IDLE=1
# Text neuer Posteingangs-Mails gleich mit vorladen (höchstens N je Lauf, je
# höchstens 1 MB, ohne Gelesen-Markierung). 0 = aus.
SELFMAILER_PREFETCH_NEW=20
# Kalender/Kontakte (DAV) laufen in einem EIGENEN, kürzeren Takt (min. 30).
SELFMAILER_DAV_SYNC_INTERVAL=120
# Wie viele Konten gleichzeitig synchronisiert werden (ein langsames Konto soll
# die anderen nicht ausbremsen).
SELFMAILER_SYNC_WORKERS=4
# 1 = Hintergrund-Sync komplett abschalten (nur für Tests/Debugging).
SELFMAILER_SYNC_DISABLE=0

# ---- IMAP-Verhalten -------------------------------------------------------
# Socket-Timeout je IMAP-Operation in Sekunden. Ohne Timeout würde ein totes
# Postfach einen Worker-Thread endlos blockieren.
SELFMAILER_IMAP_TIMEOUT=15
# 0 = Verbindungs-Pool aus (dann pro Aktion neu einloggen — deutlich langsamer).
SELFMAILER_IMAP_POOL=1
# Datensparsame Zeitmessung für authentifizierte Listen-/Lese-/Lösch-/Sync-Anfragen.
# Nur eigene Konten; keine Mailinhalte, Adressen, Ordner, UIDs oder Zugangsdaten
# in den NEUEN mail_timing-Zeilen. Bestehende Logs sind davon unabhängig.
# 0 = abschalten. Normal: ab 1000 ms oder bei Fehlern protokollieren.
SELFMAILER_MAIL_TIMING=1
# Für einen kurzen Vergleichstest auf 0 setzen (auch schnelle Anfragen erfassen),
# danach wieder 1000. Details/Datenschutz: docs/MAIL-TIMING.md.
SELFMAILER_MAIL_TIMING_SLOW_MS=1000

# ---- Backups --------------------------------------------------------------
# Nächtliches, konsistentes Backup der SQLite-DB nach <db-dir>/backups (~03:00).
SELFMAILER_BACKUP_ENABLED=true
# Wie viele Snapshots behalten werden (ältere werden rotiert; 0 = alle behalten).
SELFMAILER_BACKUP_KEEP=7
# Zielordner der Backups IM Container. Leer = <DB-Ordner>/backups (Standard).
# Empfehlung: ein zweites Volume auf einem anderen Datenträger/Share einbinden
# (siehe docker-compose.yml) und hier dessen Pfad eintragen, z. B. /backups.
# Backups bekommen Ordner 700 / Dateien 600 - nur der Container-User liest sie.
SELFMAILER_BACKUP_DIR=

# ---- Sicherheit / Netzwerk ------------------------------------------------
# Nur exakte authserv-IDs eines vertrauenswürdigen Empfangs-MTA eintragen, der
# gleichnamige, fremd eingespeiste Authentication-Results-Header entfernt.
# Leer = keine positive Authentizitätsanzeige. Siehe docs/SECURITY-UPDATE-2026-09.md.
SELFMAILER_TRUSTED_AUTHSERV_IDS=
# HS256 | HS384 | HS512
SELFMAILER_JWT_ALGORITHM=HS256
# Gültigkeitsdauer des Logins in Minuten (Standard: 7 Tage).
SELFMAILER_JWT_EXPIRE_MINUTES=10080
# ---- HTTP / HTTPS (seit 1.97.0: HTTP bleibt Standard, HTTPS ist wählbar) ----
# Secure-Flag des Session-Cookies:
#   auto  = Standard. Über http ohne, über https mit Secure-Flag - LAN per http
#           und Zugriff per https (direkt oder Reverse-Proxy) gehen gleichzeitig.
#   true  = immer Secure (nur, wenn die WebUI NIE per http aufgerufen wird).
#   false = nie Secure (Verhalten bis 1.96.9).
SELFMAILER_COOKIE_SECURE=auto
# Reverse-Proxy vor SelfMailer? Dessen IP(s) eintragen (kommagetrennt, auch
# Netze wie 172.17.0.0/16). Nur dann gelten X-Forwarded-For/-Proto: echte
# Client-IP für die Login-Bremse, https-Erkennung für Cookie "auto" und HSTS.
# Leer = nur 127.0.0.1. Ohne Proxy leer lassen.
SELFMAILER_TRUSTED_PROXIES=
# Optional HTTPS direkt im Container (ohne Reverse-Proxy): Pfade IM Container
# zu Zertifikat (inkl. Zwischenzertifikaten) und Schlüssel, beide PEM. Dann
# lauscht zusätzlich HTTPS auf SELFMAILER_TLS_PORT; HTTP auf 8090 bleibt an.
# Nur HTTPS gewünscht? Port 8090 im Container-Mapping nicht freigeben.
SELFMAILER_TLS_CERT=
SELFMAILER_TLS_KEY=
SELFMAILER_TLS_PORT=8443
# HSTS in Sekunden (z. B. 31536000 = 1 Jahr), 0 = aus. Wird nur auf
# HTTPS-Antworten gesendet. Achtung: der Browser ruft den HTTPS-Hostnamen
# danach nie mehr per http auf - LAN-Zugriff per IP bleibt davon unberührt.
SELFMAILER_HSTS_MAX_AGE=0
# true = auch private/LAN-Ziele für den CalDAV/CardDAV-Pull blockieren (strikter
# SSRF-Modus für nicht vertrauenswürdige Multi-User-Installationen). Loopback,
# Link-Local und Cloud-Metadata sind IMMER gesperrt.
SELFMAILER_DAV_BLOCK_PRIVATE=false
# Zusätzlich erlaubte Browser-Herkünfte (nur für die Entwicklung mit dem
# Vite-Devserver nötig; im Single-Container-Betrieb irrelevant).
SELFMAILER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
